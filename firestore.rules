rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function getUserGroupId() {
      return request.auth.token.groupId;
    }
    
    function belongsToGroup(groupId) {
      return isAuthenticated() && getUserGroupId() == groupId;
    }

    function isSender() {
      return resource.data.senderId == request.auth.uid;
    }

    function preservesIdentity() {
      return request.resource.data.senderId == resource.data.senderId
        && request.resource.data.type == resource.data.type;
    }
    
    match /groups/{groupId}/messages/{messageId} {
      allow read: if belongsToGroup(groupId);
      
      // Normal messages
      allow create: if belongsToGroup(groupId) && 
                       request.resource.data.type == "message" &&
                       request.resource.data.senderId == request.auth.uid;
      
      // Announcements / polls (UI gates manager; claim has no isManager yet)
      allow create: if belongsToGroup(groupId) && 
                       (request.resource.data.type == "announcement" || 
                        request.resource.data.type == "poll") &&
                       request.resource.data.senderId == request.auth.uid;
      
      // Updates: reactions, readBy, poll votes — cannot change sender/type
      allow update: if belongsToGroup(groupId) && preservesIdentity();
      
      // Sender can delete own messages; any member can delete announcement/poll
      // (manager UI only shows delete for managers)
      allow delete: if belongsToGroup(groupId) && (
                       isSender() ||
                       resource.data.type == "announcement" ||
                       resource.data.type == "poll"
                     );
    }
    
    match /groups/{groupId}/typing/{userId} {
      allow read: if belongsToGroup(groupId);
      allow write: if belongsToGroup(groupId) && userId == request.auth.uid;
    }
  }
}
